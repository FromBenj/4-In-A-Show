<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0" name="viewport">
    <meta content="ie=edge" http-equiv="X-UA-Compatible">
    <title>Welcome to 4 in a Show!</title>
    <link rel="icon" href="../assets/images/fran-tou.ico">
    <link crossorigin="anonymous" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" rel="stylesheet">
    <link href="../styles.css" rel="stylesheet">

</head>
<body data-route ="{{ route_name }}">
<div id="main-home-container" class="vh-100 vw-100">
    <div class="fw-bold" id="title-container">
        <img src="../assets/images/tagline-home.png" alt="Are you ready to play?">
    </div>
    <form action="./play-area" id="players-form" method="post">
        <div class="d-flex flex-column flex-sm-row justify-content-center align-items-end">
            <div class="m-5">
                <div class="text-center fw-bold">
                    <label for="player_1" class="h2"> Player 1 </label>
                </div>
                <input id="player_1" minlength="1" name="player_1" type="text"/>
            </div>
            <div class="m-5">
                <div class="text-center fw-bold">
                    <label for="player_2" class="h2"> Player 2 </label>
                </div>
                <input id="player_2" minlength="1" name="player_2" type="text"/>
            </div>
        </div>
        <input type="hidden" name="page" value="play-area">
        <div class="d-flex justify-content-center align-items-center">
            <input id="submit-button-home" class="h2" type="submit" value="Go!"/>
        </div>
    </form>
</div>

<script src="../js/gsap.min.js"></script>
<script type="module" src="../main.js"></script>
<script crossorigin="anonymous" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

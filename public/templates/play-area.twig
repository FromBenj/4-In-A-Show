<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0" name="viewport">
    <meta content="ie=edge" http-equiv="X-UA-Compatible">
    <title>Play Area</title>
    <link rel="icon" href="../assets/images/fran-tou.ico">
    <link crossorigin="anonymous" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" rel="stylesheet">
    <link href="../assets/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="../styles.css" rel="stylesheet">
</head>
<body data-route ="{{ route_name }}">
{#    Splash Animation#}
<div id="splash" class="d-none">
    <img src="../assets/images/splash-icon.svg" alt="splash icon">
</div>
<div id="token-cursor" class=""></div>
<div class="vw-100 vh-100 d-flex flex-column justify-content-center align-items-center">
    <div class="container" id="game-board">
        {% for i in 5..0 %}
            <div class="row tokens-row flex-nowrap">
                {% for j in 0..6 %}
                    <div class="col">
                        <div class="token-place bg-white" data-player="" data-row="{{ i }}" data-col="{{ j }}"></div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
    <div id="players-container" class="position-relative mt-5 d-flex justify-content-between align-items-center">
        <div id="token-player1-container" class="d-flex align-items-center position-relative">
            <div class="position-relative">
                <div id="moving-dot"></div>
                <div id="token-player1" class="mx-2 main-blue light-color"></div>
            </div>
            <h3 class="m-0 mx-2">{{ player_1.name }}</h3>
        </div>
        <div class="d-flex align-items-center">
            <h3 class="m-0 mx-2">{{ player_2.name }}</h3>
            <div id="token-player2" class="main-yellow mx-2 light-color"></div>
        </div>
    </div>
</div>

<script src="../js/gsap.min.js"></script>
<script type="module" src='../main.js'></script>
<script crossorigin="anonymous" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

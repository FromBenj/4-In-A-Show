<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0" name="viewport">
    <meta content="ie=edge" http-equiv="X-UA-Compatible">
    <title>Play Area</title>
    <link crossorigin="anonymous" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" rel="stylesheet">
    <link href="../assets/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="../styles.css" rel="stylesheet">
</head>
<body>
<div class="container" id="game-board">
    {% for i in 6..1 %}
        <div class="row tokens-row flex-nowrap">
            {% for j in 1..7 %}
                <div class="col">
                    <div class="token-place bg-white" data-player="" data-row="{{ i }}" data-col="{{ j }}"></div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
<div class="mt-5 d-flex justify-content-around align-items-center">
    <div class="d-flex align-items-center">
        <h3 class="m-0 mx-2">{{ fixtures.player1Name }}</h3>
        <div id="token-player1" class="main-blue mx-2"></div>
    </div>
    <div class="d-flex align-items-center">
        <div id="token-player2" class="main-yellow mx-2 d-none"></div>
        <h3 class="m-0 mx-2">{{ fixtures.player2Name }}</h3>
    </div>
</div>

<script type="module" src='../main.js'></script>
<script crossorigin="anonymous" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
